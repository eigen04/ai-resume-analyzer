# ==============================================================================
# AI Resume Analyzer — Environment Variables
# Copy this file to .env and fill in your values before running docker-compose
# ==============================================================================

# Database
DB_URL=jdbc:postgresql://localhost:5440/resume_analyzer
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_PORT=5440

# Ollama (Embeddings only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Groq (Cloud LLM for blazing fast Llama-3-70B Chat processing)
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here

# Server
SERVER_PORT=8080

# JWT Authentication
# Generate a secure key: openssl rand -base64 64
JWT_SECRET=<your-base64-encoded-secret-key-here>
